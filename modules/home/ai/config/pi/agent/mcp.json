{
  "mcp": {
    "toolMode": "proxy",
    "startup": "lazy",
    "servers": {
      "open-computer-use": {
        "type": "local",
        "command": ["open-computer-use", "mcp"],
        "enabled": true,
        "timeout": 60000
      },
      "chrome-devtools": {
        "type": "local",
        "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
        "enabled": true,
        "timeout": 60000
      },
      "asana": {
        "type": "remote",
        "url": "https://mcp.asana.com/sse",
        "oauth": {}
      }
    }
  }
}
